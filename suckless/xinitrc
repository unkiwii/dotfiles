#!/usr/bin/env zsh

update-monitor-layout

set-keyboard-layout

# desktop wallpaper (for both monitors)
feh --bg-scale ~/dotfiles/thrill_seekers_orange.png ~/dotfiles/thrill_seekers_orange.png

# start the session with some programs open
(st -e tmux) &
(sleep 1s; google-chrome || google-chrome-stable) &
(sleep 2s; slack) &
(sleep 3s; firefox || librewolf) &
(sleep 4s; new-godo-window) &

# systray && systray icons
(slstatus) &
(sleep 1s; wpa_gui -t -i wlp0s20f3) &

# clocks to show different timezones
TZ='America/Bogota' clock
TZ='America/New_York' clock
TZ='America/Los_Angeles' clock
TZ='America/Argentina/Buenos_Aires' clock
TZ='Asia/Bangkok' clock
TZ='Europe/Berlin' clock

# set grid layout on tag 9 of dwm after 30 seconds
(sleep 1s; xdotool key super+9 key super+g key super+1) &

# start dwm
exec dbus-launch dwm 2> ~/.dwm.log
